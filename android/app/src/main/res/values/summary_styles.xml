<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Checkmate.SummaryButton" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">20sp</item>
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@null</item>
    </style>
    <style name="Widget.Checkmate.SummaryPeriod" parent="Widget.Checkmate.SummaryButton">
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/nav_background</item>
        <item name="android:textColor">@color/nav_text</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
    </style>
</resources>
