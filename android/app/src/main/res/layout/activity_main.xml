<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:background="@color/background">
    <TextView android:id="@+id/brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/ui_brand" android:textSize="26sp" android:textColor="@color/text_primary"/>
    <TextView android:id="@+id/ux_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/ui_ux_status" android:textSize="16sp" android:textColor="@color/text_secondary"/>
    <TextView android:id="@+id/restriction_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/ui_restriction_notice" android:textSize="22sp" android:textColor="@color/text_primary"/>
    <LinearLayout android:id="@+id/details" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:backgroundTint="@color/surface" android:textColor="@color/button_text" android:id="@+id/show_current" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_show_current" android:textSize="18sp"/>
            <Button android:backgroundTint="@color/surface" android:textColor="@color/button_text" android:id="@+id/show_history" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_show_history" android:textSize="18sp"/>
            <Button android:backgroundTint="@color/surface" android:textColor="@color/button_text" android:id="@+id/show_profile" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_show_profile" android:textSize="18sp"/>
        </LinearLayout>
        <ScrollView android:id="@+id/content_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/current_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/current_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/ui_current_title" android:textSize="28sp" android:textColor="@color/text_primary"/>
                    <TextView android:id="@+id/warning_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/ui_warning_list" android:textSize="20sp" android:textColor="@color/text_primary"/>
                    <LinearLayout android:id="@+id/warning_cards" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                    <LinearLayout android:id="@+id/connection_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/status_background" android:padding="20dp" android:layout_marginBottom="20dp">
                        <TextView android:id="@+id/connection_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/ui_connection_status" android:textSize="20sp" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/last_received" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="" android:textSize="16sp" android:textColor="@color/text_secondary"/>
                        <Button android:backgroundTint="@color/surface" android:textColor="@color/button_text" android:id="@+id/retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_retry" android:textSize="18sp"/>
                    </LinearLayout>
                    <Button android:backgroundTint="@color/surface" android:textColor="@color/button_text" android:id="@+id/toggle_diagnostics" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_toggle_diagnostics" android:textSize="18sp"/>
                    <LinearLayout android:id="@+id/diagnostics_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:id="@+id/event_scope" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/ui_event_scope" android:textSize="16sp" android:textColor="@color/text_secondary"/>
                        <TextView android:id="@+id/event_log" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="" android:textSize="18sp" android:textColor="@color/text_primary"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/history_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/history_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/ui_history_title" android:textSize="28sp" android:textColor="@color/text_primary"/>
                    <TextView android:id="@+id/history_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/ui_history_description" android:textSize="18sp" android:textColor="@color/text_secondary"/>
                    <TextView android:id="@+id/history_page" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="" android:textSize="18sp" android:textColor="@color/text_primary"/>
                    <Button android:backgroundTint="@color/surface" android:textColor="@color/button_text" android:id="@+id/refresh_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_refresh_history" android:textSize="18sp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:backgroundTint="@color/surface" android:textColor="@color/button_text" android:id="@+id/previous_page" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_previous_page" android:textSize="18sp"/>
                        <Button android:backgroundTint="@color/surface" android:textColor="@color/button_text" android:id="@+id/next_page" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_next_page" android:textSize="18sp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/history_entries" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="" android:textSize="18sp" android:textColor="@color/text_primary"/>
                    <LinearLayout android:id="@+id/history_cards" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/detail_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <Button android:backgroundTint="@color/surface" android:textColor="@color/button_text" android:id="@+id/detail_back" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_detail_back" android:textSize="18sp"/>
                    <TextView android:id="@+id/detail_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/ui_detail_title" android:textSize="28sp" android:textColor="@color/text_primary"/>
                    <LinearLayout android:id="@+id/facts_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/status_background" android:padding="20dp" android:layout_marginBottom="20dp">
                        <TextView android:id="@+id/detail_context" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="" android:textSize="18sp" android:textColor="@color/text_secondary"/>
                        <TextView android:id="@+id/detail_facts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="" android:textSize="22sp" android:textColor="@color/text_primary"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/manual_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/status_background" android:padding="20dp" android:layout_marginBottom="20dp">
                        <TextView android:id="@+id/manual_profile_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/ui_manual_profile_label" android:textSize="20sp" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/detail_profile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/ui_detail_profile" android:textSize="18sp" android:textColor="@color/text_primary"/>
                        <Button android:backgroundTint="@color/surface" android:textColor="@color/button_text" android:id="@+id/detail_choose_profile" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_detail_choose_profile" android:textSize="18sp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/profile_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <Button android:backgroundTint="@color/surface" android:textColor="@color/button_text" android:id="@+id/profile_back" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/ui_profile_back" android:textSize="18sp"/>
                    <TextView android:id="@+id/profile_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/ui_profile_title" android:textSize="28sp" android:textColor="@color/text_primary"/>
                    <TextView android:id="@+id/profile_help" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/ui_profile_help" android:textSize="18sp" android:textColor="@color/text_secondary"/>
                    <TextView android:id="@+id/selected_profile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="" android:textSize="20sp" android:textColor="@color/text_primary"/>
                    <LinearLayout android:id="@+id/profile_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                    <Button android:backgroundTint="@color/surface" android:textColor="@color/button_text" android:id="@+id/clear_profile" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_clear_profile" android:textSize="18sp"/>
                    <TextView android:id="@+id/profile_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="" android:textSize="16sp" android:textColor="@color/text_secondary"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <TextView android:id="@+id/storage_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="" android:textSize="14sp" android:textColor="@color/text_secondary"/>
    </LinearLayout>
</LinearLayout>
