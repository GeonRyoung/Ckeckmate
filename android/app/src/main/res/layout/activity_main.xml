<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:background="@color/background">
    <TextView android:id="@+id/brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/ui_brand" android:textSize="24sp" android:textColor="@color/accent" android:lineSpacingExtra="6dp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.08"/>
    <TextView android:id="@+id/ux_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" android:text="@string/ui_ux_status" android:textSize="18sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="6dp"/>
    <TextView android:id="@+id/restriction_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/ui_restriction_notice" android:textSize="22sp" android:textColor="@color/text_primary" android:lineSpacingExtra="6dp"/>
    <LinearLayout android:id="@+id/details" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="6dp" android:background="@drawable/status_background" android:layout_marginBottom="24dp">
            <Button android:textColor="@color/nav_text" android:id="@+id/show_current" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_show_current" android:textSize="22sp" android:background="@drawable/nav_background" android:fontFamily="sans-serif-medium" android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_marginBottom="0dp" android:stateListAnimator="@null" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"/>
            <Button android:textColor="@color/nav_text" android:id="@+id/show_history" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_show_history" android:textSize="22sp" android:background="@drawable/nav_background" android:fontFamily="sans-serif-medium" android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_marginBottom="0dp" android:stateListAnimator="@null" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"/>
            <Button android:textColor="@color/nav_text" android:id="@+id/show_profile" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_show_profile" android:textSize="22sp" android:background="@drawable/nav_background" android:fontFamily="sans-serif-medium" android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_marginBottom="0dp" android:stateListAnimator="@null" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"/>
        </LinearLayout>
        <ScrollView android:id="@+id/content_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
                <LinearLayout android:id="@+id/current_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/current_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/ui_current_title" android:textSize="32sp" android:textColor="@color/text_primary" android:lineSpacingExtra="6dp" android:fontFamily="sans-serif-medium" android:layout_marginTop="8dp"/>
                    <TextView android:id="@+id/warning_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" android:text="@string/ui_warning_list" android:textSize="20sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="6dp"/>
                    <LinearLayout android:id="@+id/warning_cards" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                    <LinearLayout android:id="@+id/connection_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/status_background" android:padding="24dp" android:layout_marginBottom="24dp">
                        <TextView android:id="@+id/connection_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/ui_connection_status" android:textSize="20sp" android:textColor="@color/text_primary" android:lineSpacingExtra="6dp"/>
                        <TextView android:id="@+id/last_received" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="" android:textSize="18sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="6dp"/>
                        <Button android:textColor="@color/button_text" android:id="@+id/retry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_retry" android:textSize="20sp" android:background="@drawable/button_background" android:fontFamily="sans-serif-medium" android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_marginBottom="12dp" android:stateListAnimator="@null" android:minWidth="180dp"/>
                    </LinearLayout>
                    <Button android:textColor="@color/button_text" android:id="@+id/toggle_diagnostics" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_toggle_diagnostics" android:textSize="20sp" android:background="@drawable/button_background" android:fontFamily="sans-serif-medium" android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_marginBottom="12dp" android:stateListAnimator="@null" android:minWidth="180dp"/>
                    <LinearLayout android:id="@+id/diagnostics_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:id="@+id/event_scope" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/ui_event_scope" android:textSize="16sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="6dp"/>
                        <TextView android:id="@+id/event_log" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="" android:textSize="18sp" android:textColor="@color/text_primary" android:lineSpacingExtra="6dp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/history_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/history_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/ui_history_title" android:textSize="32sp" android:textColor="@color/text_primary" android:lineSpacingExtra="6dp" android:fontFamily="sans-serif-medium" android:layout_marginTop="8dp"/>
                    <TextView android:id="@+id/history_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" android:text="@string/ui_history_description" android:textSize="20sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="6dp"/>
                    <TextView android:id="@+id/history_page" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="" android:textSize="18sp" android:textColor="@color/text_primary" android:lineSpacingExtra="6dp"/>
                    <Button android:textColor="@color/button_text" android:id="@+id/refresh_history" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_refresh_history" android:textSize="20sp" android:background="@drawable/button_background" android:fontFamily="sans-serif-medium" android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_marginBottom="12dp" android:stateListAnimator="@null" android:minWidth="180dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:textColor="@color/button_text" android:id="@+id/previous_page" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_previous_page" android:textSize="20sp" android:background="@drawable/button_background" android:fontFamily="sans-serif-medium" android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_marginBottom="12dp" android:stateListAnimator="@null" android:layout_marginEnd="8dp"/>
                        <Button android:textColor="@color/button_text" android:id="@+id/next_page" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_next_page" android:textSize="20sp" android:background="@drawable/button_background" android:fontFamily="sans-serif-medium" android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_marginBottom="12dp" android:stateListAnimator="@null" android:layout_marginEnd="8dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/history_entries" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="" android:textSize="18sp" android:textColor="@color/text_primary" android:lineSpacingExtra="6dp"/>
                    <LinearLayout android:id="@+id/history_cards" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/detail_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <Button android:textColor="@color/button_text" android:id="@+id/detail_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_detail_back" android:textSize="20sp" android:background="@drawable/button_background" android:fontFamily="sans-serif-medium" android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_marginBottom="12dp" android:stateListAnimator="@null" android:minWidth="180dp"/>
                    <TextView android:id="@+id/detail_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/ui_detail_title" android:textSize="32sp" android:textColor="@color/text_primary" android:lineSpacingExtra="6dp" android:fontFamily="sans-serif-medium" android:layout_marginTop="8dp"/>
                    <LinearLayout android:id="@+id/facts_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/status_background" android:padding="24dp" android:layout_marginBottom="24dp">
                        <TextView android:id="@+id/detail_context" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="" android:textSize="18sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="6dp"/>
                        <TextView android:id="@+id/detail_facts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="" android:textSize="24sp" android:textColor="@color/text_primary" android:lineSpacingExtra="8dp"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/manual_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/status_background" android:padding="24dp" android:layout_marginBottom="24dp">
                        <TextView android:id="@+id/manual_profile_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/ui_manual_profile_label" android:textSize="24sp" android:textColor="@color/text_primary" android:lineSpacingExtra="6dp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/detail_profile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/ui_detail_profile" android:textSize="18sp" android:textColor="@color/text_primary" android:lineSpacingExtra="6dp"/>
                        <Button android:textColor="@color/button_text" android:id="@+id/detail_choose_profile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_detail_choose_profile" android:textSize="20sp" android:background="@drawable/button_background" android:fontFamily="sans-serif-medium" android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_marginBottom="12dp" android:stateListAnimator="@null" android:minWidth="180dp"/>
                        <TextView android:id="@+id/guide_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="" android:textSize="24sp" android:textColor="@color/text_primary" android:lineSpacingExtra="6dp" android:fontFamily="sans-serif-medium"/>
                        <TextView android:id="@+id/guide_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="" android:textSize="24sp" android:textColor="@color/text_primary" android:lineSpacingExtra="8dp"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/limits_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:layout_marginBottom="24dp" android:background="@drawable/status_background">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/limits_heading" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:layout_marginBottom="12dp"/>
                        <TextView android:id="@+id/guide_limits" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="" android:textSize="20sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="6dp"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/source_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:layout_marginBottom="24dp" android:background="@drawable/status_background">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/source_heading" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:layout_marginBottom="12dp"/>
                        <TextView android:id="@+id/guide_citation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="" android:textSize="18sp" android:textColor="@color/text_secondary" android:textIsSelectable="true" android:lineSpacingExtra="6dp"/>
                        <Button android:id="@+id/open_source" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/open_manual_source" android:textSize="20sp" android:textColor="@color/button_text" android:minHeight="64dp" android:background="@drawable/button_background" android:fontFamily="sans-serif-medium" android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_marginBottom="12dp" android:stateListAnimator="@null" android:minWidth="180dp"/>
                        <TextView android:id="@+id/source_open_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="" android:textSize="18sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="6dp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/profile_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <Button android:textColor="@color/button_text" android:id="@+id/profile_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/ui_profile_back" android:textSize="20sp" android:background="@drawable/button_background" android:fontFamily="sans-serif-medium" android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_marginBottom="12dp" android:stateListAnimator="@null" android:minWidth="180dp"/>
                    <TextView android:id="@+id/profile_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/ui_profile_title" android:textSize="32sp" android:textColor="@color/text_primary" android:lineSpacingExtra="6dp" android:fontFamily="sans-serif-medium" android:layout_marginTop="8dp"/>
                    <TextView android:id="@+id/profile_help" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" android:text="@string/ui_profile_help" android:textSize="20sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="6dp"/>
                    <TextView android:id="@+id/selected_profile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="" android:textSize="20sp" android:textColor="@color/text_primary" android:lineSpacingExtra="6dp"/>
                    <LinearLayout android:id="@+id/profile_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                    <Button android:textColor="@color/button_text" android:id="@+id/clear_profile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="64dp" android:textAllCaps="false" android:text="@string/ui_clear_profile" android:textSize="20sp" android:background="@drawable/button_background" android:fontFamily="sans-serif-medium" android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_marginBottom="12dp" android:stateListAnimator="@null" android:minWidth="180dp"/>
                    <TextView android:id="@+id/profile_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="" android:textSize="18sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="6dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <TextView android:id="@+id/storage_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="0dp" android:text="" android:textSize="16sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="6dp" android:layout_marginTop="12dp"/>
    </LinearLayout>
</LinearLayout>
