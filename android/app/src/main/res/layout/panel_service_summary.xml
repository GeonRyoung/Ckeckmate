<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <Button
        android:id="@+id/summary_back"
        style="@style/Widget.Checkmate.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-12dp"
        android:drawableStart="@drawable/ic_arrow_back"
        android:drawablePadding="10dp"
        android:minHeight="56dp"
        android:text="@string/summary_back"
        android:textColor="@color/text_secondary"
        android:textSize="19sp"
        app:drawableTint="@color/text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="bottom"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                style="@style/Text.Checkmate.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Service handoff" />
            <TextView
                style="@style/Text.Checkmate.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/summary_title" />
            <TextView
                style="@style/Text.Checkmate.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/summary_help" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:background="@drawable/segment_track"
            android:orientation="horizontal"
            android:padding="6dp">
            <Button
                android:id="@+id/summary_today"
                style="@style/Widget.Checkmate.SummaryPeriod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/summary_today" />
            <Button
                android:id="@+id/summary_week"
                style="@style/Widget.Checkmate.SummaryPeriod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/summary_week" />
            <Button
                android:id="@+id/summary_month"
                style="@style/Widget.Checkmate.SummaryPeriod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/summary_month" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/Widget.Checkmate.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/summary_status"
                style="@style/Text.Checkmate.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <Button
                android:id="@+id/summary_refresh"
                style="@style/Widget.Checkmate.SummaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:drawableStart="@drawable/ic_refresh"
                android:drawablePadding="10dp"
                android:minHeight="60dp"
                android:text="@string/summary_refresh"
                android:textSize="19sp"
                app:drawableTint="@color/button_text" />
        </LinearLayout>
        <TextView
            android:id="@+id/summary_body"
            style="@style/Text.Checkmate.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/soft_box"
            android:padding="28dp"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
