# reviewed: reviewed evidence retrieval; ollama: real local model generation
CHECKMATE_GENERATION=reviewed
# QUESTION ranking inside the profile/warning filter.
# lexical: no model; embedding: Ollama /api/embed in memory; qdrant: bge-m3 vectors in Qdrant
CHECKMATE_RETRIEVAL=lexical
# Questions whose top bge-m3 cosine is below this abstain with NO_EVIDENCE (provisional, see README)
# CHECKMATE_MIN_SCORE=0.50
# Qdrant local file (default backend/.local/qdrant) or a server URL
# CHECKMATE_QDRANT_PATH=
# CHECKMATE_QDRANT_URL=http://127.0.0.1:6333
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3
# CPU-only laptop: set 0 explicitly (unset preserves Ollama automatic device selection).
# OLLAMA_EMBED_NUM_GPU=0
